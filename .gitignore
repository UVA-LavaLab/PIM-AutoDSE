# ---------------------------------------------------------------------------
# Project files
# ---------------------------------------------------------------------------
libpimeval/build/
libpimeval/lib/
result-local.txt

# LSP
compile_commands.json
.cache

# C++ object files
*.o
*.dSYM/
*.out

# Editors
.vscode/

# ---------------------------------------------------------------------------
# Benchmark build products
# ---------------------------------------------------------------------------
# Populated by setup.sh with symlinks to the built simulator and the ISA
# lowering headers - see stage_libpimsim().
benchmarks/libpimsim/
benchmarks/*/bin/
benchmarks/logs/
benchmarks/results/
benchmarks/**/*_compute_log
benchmarks/**/*_data_movement_log
benchmarks/**/*_pim_header.h
benchmarks/**/*_pim_header.h.defs

# Halide / MISAAL codegen scratch (see the `clean` target)
halide_expr_*
*_misaal.py
*_misaal_misaal.py
*.rkt
*.egg
egg.out.txt*
pim_fused_lowering.h

# ---------------------------------------------------------------------------
# DSE run artifacts
# ---------------------------------------------------------------------------
*_fused_log.txt
*_unfused_log.txt
check_log
check_log_fused
perf_logs/
dse_logs/
dse_logs_*/
dse_perf_logs_*/
aqbolt_dse_logs/
work_dir_*/
*_test.cpp
failed.log

# ---------------------------------------------------------------------------
# Generated / vendored binaries
# ---------------------------------------------------------------------------
*.a
*.so
*.pickle
*.tar.gz

# Enumerator outputs (regenerate via isa/gen)
fused_lower.cpp
unfused_lower.cpp

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo

# PLY parser caches (regenerated on import)
parser.out
parsetab.py

# OpenTuner (its SQLite DB is named after the hostname - never commit)
opentuner.db/
*.db
*.db-journal

# ---------------------------------------------------------------------------
# Scratch
# ---------------------------------------------------------------------------
tmp.txt
log

# ---------------------------------------------------------------------------
# Lowering libraries (generated by setup.sh - see build_lowering_libs)
#   *_lib.o     ~65 MB each, compiled once from isa/lowering/*_lower.h
#   decls/      declarations-only headers derived from the same
# ---------------------------------------------------------------------------
benchmarks/libpimsim/*_lib.o
benchmarks/libpimsim/*_lib.cpp
benchmarks/libpimsim/decls/

# ---------------------------------------------------------------------------
# Generated DSE sweep configs (~1,100 files). Kept locally, not in the repo;
# regenerate with dse/generate_regsweep_cfg_files.py. The five evaluation
# configs in dse/cfgs/autodse_eval_cfgs/ stay tracked.
# ---------------------------------------------------------------------------
dse/cfgs/*
!dse/cfgs/autodse_eval_cfgs/

# ---------------------------------------------------------------------------
# results/ is a local output directory for sweep CSVs - nothing in it is
# committed except the placeholder that keeps the directory in the checkout.
# ---------------------------------------------------------------------------
results/*
!results/.gitkeep
